max-history=100
sort=-time

font=FiraCode Nerd Font 10
width=350
height=150
margin=5
padding=15
border-size=2
border-radius=0
progress-color=source #b8bb26

background-color=#282828ff
border-color=#928374ff
text-color=#ebdbb2ff

[urgency=low]
border-color=#665c54ff
text-color=#a89984ff
default-timeout=2000

[urgency=normal]
border-color=#b8bb26ff
default-timeout=4000

[urgency=high]
border-color=#fb4934ff
text-color=#fe8019ff
default-timeout=0
