configuration {
    modi:                       "drun";
    show-icons:                 false; /* Disabled icons */
    drun-display-format:        "{name}";
    font:                       "FiraCode Nerd Font 11";
}

@theme "/dev/null"

* {
    /* Muted Gruvbox Grayscale Palette */
    bg:     #282828; 
    cur:    #3c3836; 
    sel:    #504945; 
    fg:     #ebdbb2; 
    muted:  #7c6f64; 
    accent: #a89984; 

    background-color:   transparent;
    text-color:         @fg;
    margin:             0;
    padding:            0;
    spacing:            0;
}

window {
    width:              480px;
    background-color:   @bg; 
    border:             2px;
    border-color:       @cur; 
    border-radius:      0px; 
}

mainbox {
    children:           [ inputbar, listview ];
}

inputbar {
    children:           [ entry ]; /* Removed the prompt icon/text entirely */
    background-color:   @cur; 
    padding:            12px;
}

entry {
    placeholder:        "Search...";
    placeholder-color:  @muted;
}

listview {
    lines:              5;
    columns:            1;
    fixed-height:       false;
    padding:            10px;
    spacing:            4px;
}

element {
    orientation:        horizontal;
    padding:            8px 12px;
    border-radius:      0px; 
}

element selected {
    background-color:   @sel; 
}

element-text selected {
    text-color:         @fg;  
}

element-text {
    vertical-align:     0.5;
    text-color:         @fg;
}
